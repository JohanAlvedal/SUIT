<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SUIT</vendor>
  <action id="se.alvedal.suit.helper">
    <description>Change dartboard PC system settings</description>
    <message>SUIT needs administrator rights to change touchscreen calibration, automatic login or the Autodarts service.</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <!-- One password prompt, then remembered for a few minutes. -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/suit/suit-helper</annotate>
  </action>
</policyconfig>
